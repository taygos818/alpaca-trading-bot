# Copy to .env.paper.secrets. Never put live Alpaca credentials in this project.
ALPACA_API_KEY=replace-with-paper-key
ALPACA_SECRET_KEY=replace-with-paper-secret
ALPACA_PAPER_TRADE=true
ALPACA_TRADING_API_URL=https://paper-api.alpaca.markets

# Execution is intentionally disabled at bootstrap.
ALPACA_ORDER_DRY_RUN=true
PAPER_ORDER_DRY_RUN=true
PAPER_ORDER_SUBMISSION_ENABLED=false
BOT_ENVIRONMENT=paper
TRADING_LANE=options_paper
ACTIVE_BROKER=alpaca
AGENT_COORDINATOR_ENABLED=false
AGENT_COORDINATOR_SHADOW_MODE=true

# Isolated infrastructure.
PAPER_POSTGRES_PASSWORD=replace-with-random-password
PAPER_POSTGRES_PORT=56433
PAPER_REDIS_PORT=57380
ALPACA_MCP_HOST_PORT=8181

# Featherless uses an OpenAI-compatible API. Select and pin the contest model later.
FEATHERLESS_API_KEY=replace-with-featherless-key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=replace-with-approved-model
FEATHERLESS_TIMEOUT_SECONDS=30

# Research providers. Each integration remains disabled until its milestone passes.
FINNHUB_API_KEY=replace-with-finnhub-key
FINNHUB_ENABLED=false
FINNHUB_ENTITLEMENT=replace-with-account-entitlement
FINNHUB_TIMEOUT_SECONDS=10
FINNHUB_CACHE_TTL_SECONDS=300
FINNHUB_MAX_NEWS_AGE_HOURS=72
YFINANCE_ENABLED=false
YFINANCE_TIMEOUT_SECONDS=10
YFINANCE_CACHE_TTL_SECONDS=900
YFINANCE_MAX_HISTORY_AGE_DAYS=400
YFINANCE_MAX_CALENDAR_HORIZON_DAYS=120
FRED_API_KEY=replace-with-fred-key
FRED_ENABLED=false
FRED_TIMEOUT_SECONDS=10
FRED_CACHE_TTL_SECONDS=86400

ALLOW_MOCK_DATA_FALLBACK=false
ALLOW_MOCK_IV_RANK=false
REQUIRE_BROKER_STATE_FOR_TRADES=true
MAX_TRADE_RISK_PCT=0.01
DAILY_DRAWDOWN_LIMIT=0.03
MAX_CONCENTRATION_PCT=0.15
MAX_GROSS_EXPOSURE_PCT=0.50
MIN_CASH_BUFFER_PCT=0.20
